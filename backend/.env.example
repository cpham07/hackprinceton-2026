# Copy to backend/.env and fill in. Never commit .env (it is git-ignored). Blank values count as unset.

# --- provider: any OpenAI-compatible API ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- models ---
# TRANSCRIPTION_MODEL=whisper-1
# NPC_DIALOGUE_MODEL=gpt-4o-mini

# --- optional: use a different provider/key for one service ---
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_BASE_URL=
# NPC_DIALOGUE_API_KEY=
# NPC_DIALOGUE_BASE_URL=

# --- transcription tuning ---
# TRANSCRIPTION_LANGUAGE=en        # blank = auto-detect
# TRANSCRIPTION_VOCABULARY_HINTS=true   # false = no prompt (plain transcription)
# TRANSCRIPTION_PROMPT=            # replaces the mythology vocabulary hint (config.py)
# MAX_AUDIO_BYTES=10485760
# TRANSCRIPTION_TIMEOUT_SECONDS=45

# --- dialogue tuning ---
# NPC_DIALOGUE_TIMEOUT_SECONDS=20
# NPC_DIALOGUE_MAX_TOKENS=220
# NPC_DIALOGUE_TEMPERATURE=0.8

# --- CORS: comma-separated origins allowed to call the API (default: the Vite dev server) ---
# CORS_ORIGINS=http://localhost:5173
